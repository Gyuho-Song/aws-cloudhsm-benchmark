{
  "app": "npx ts-node --prefer-ts-exts bin/hsm-bmt.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "package*.json", "yarn.lock", "node_modules", "test"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "desiredHsmCount": 6,
    "sdsAccountId": "000000000000",
    "sdsExternalId": "hsm-bmt-handoff",
    "repositoryProvider": "codecommit",
    "enableCustomAuthorizer": true
  }
}
