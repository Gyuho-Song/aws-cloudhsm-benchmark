# Build output
target/
*.jar
*.class
dist/
out/
.next/
build/

# Node
node_modules/
tsconfig.tsbuildinfo

# CDK
cdk.out/
*.cdk.staging/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs / tmp
*.log
*.log.*.gz
.tmp/
tmp/

# Local env / secrets
.env
.env.*
*.pem
*.key

# Maven
.mvn/wrapper/maven-wrapper.jar

# Reports / coverage
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS-specific binary that shouldn't be tracked
*.tgz

# CDK TypeScript build artifacts
iac/lib/**/*.js
iac/lib/**/*.d.ts
iac/test/**/*.js
iac/test/**/*.d.ts

# CDK context cache (account-specific)
iac/cdk.context.json
# Jest snapshot artifacts (regenerated by 'npm test -u')
**/__snapshots__/

# CDK app entry build artifacts
iac/bin/*.js
iac/bin/*.d.ts
